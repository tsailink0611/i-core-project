# 既存Firebase設定 ai-line-step-prod プロジェクト活用
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# 既存LINE設定（プロジェクトから流用予定）
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
NEXT_PUBLIC_LINE_LIFF_ID=your_liff_id

# LLM API設定（新規）
# GPT-5-mini用のAPIキーを設定してください
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# l-core専用設定
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXTAUTH_SECRET=your_nextauth_secret_here
L_CORE_ENCRYPTION_KEY=your_encryption_key_here

# 既存システム統合設定
EXISTING_SYSTEM_INTEGRATION=true
MIGRATE_EXISTING_DATA=false
BACKUP_EXISTING_CONFIG=true
