# =====================================================
# 不動産LINE-Dify統合システム 環境変数テンプレート
# =====================================================
# このファイルを .env にコピーして、各値を実際の値に置き換えてください
# セキュリティ上、.env ファイルは Git にコミットしないでください

# =====================================================
# Google Drive API 設定
# =====================================================
# Google Cloud Console で作成したサービスアカウントの認証情報ファイルパス
GOOGLE_CREDENTIALS_PATH=./credentials.json

# 監視対象のGoogle DriveルートフォルダID
# 取得方法: Google Drive でフォルダを開き、URLから取得
# 例: https://drive.google.com/drive/folders/XXXXXXXXXXXXXXXXXX
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id_here

# =====================================================
# Dify API 設定
# =====================================================
# Dify APIキー
# 取得方法: Dify Console > Settings > API Keys > Create API Key
DIFY_API_KEY=your_dify_api_key_here

# Dify APIベースURL
# SaaSの場合: https://api.dify.ai/v1
# セルフホストの場合: https://your-dify-instance.com/v1
DIFY_API_BASE_URL=https://api.dify.ai/v1

# Dify ワークフローアプリID
# 取得方法: Dify Studio > アプリ選択 > Settings > App ID
DIFY_APP_ID=your_dify_app_id_here

# =====================================================
# Dify ナレッジベース (Dataset) ID
# =====================================================
# 取得方法: Dify Console > Knowledge > 各データセット > Settings > Dataset ID

# SUUMO物件ナレッジベース
DIFY_DATASET_SUUMO=your_suumo_dataset_id_here

# 自社管理物件ナレッジベース
DIFY_DATASET_JISSHA=your_jissha_dataset_id_here

# 元付け業者物件ナレッジベース
DIFY_DATASET_MOTOTSUKE=your_mototsuke_dataset_id_here

# 会社情報ナレッジベース
DIFY_DATASET_COMPANY=your_company_dataset_id_here

# サービス情報ナレッジベース
DIFY_DATASET_SERVICE=your_service_dataset_id_here

# その他ナレッジベース
DIFY_DATASET_OTHER=your_other_dataset_id_here

# =====================================================
# LINE Messaging API 設定
# =====================================================
# LINE Developers Console で取得
# https://developers.line.biz/console/

# チャネルアクセストークン (長期)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# チャネルシークレット
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Webhook URL (デプロイ後に設定)
# 例: https://your-domain.com/api/line/webhook
LINE_WEBHOOK_URL=https://your-domain.com/api/line/webhook

# =====================================================
# サーバー設定
# =====================================================
# アプリケーションポート
PORT=8000

# ホスト (本番環境では 0.0.0.0、開発環境では 127.0.0.1)
HOST=0.0.0.0

# 実行環境 (development / production)
ENVIRONMENT=production

# ログレベル (DEBUG / INFO / WARNING / ERROR / CRITICAL)
LOG_LEVEL=INFO

# ログファイル保存先
LOG_FILE=/var/log/real_estate_line_dify/app.log

# =====================================================
# データベース設定 (オプション)
# =====================================================
# 会話履歴やユーザー管理に使用する場合

# データベース種類 (sqlite / postgresql / mysql)
# DATABASE_TYPE=sqlite

# SQLiteの場合
# DATABASE_PATH=/opt/real_estate_line_dify/data/app.db

# PostgreSQL/MySQLの場合
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=real_estate_line_dify
# DATABASE_USER=your_db_user
# DATABASE_PASSWORD=your_db_password

# =====================================================
# セキュリティ設定
# =====================================================
# アプリケーションシークレットキー (ランダムな文字列)
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# CORS許可オリジン (カンマ区切り)
CORS_ORIGINS=https://your-frontend-domain.com,https://line.me

# =====================================================
# Google Drive 監視スクリプト設定
# =====================================================
# 監視間隔 (分)
DRIVE_WATCH_INTERVAL=10

# 状態ファイル保存先
DRIVE_STATE_FILE=/opt/real_estate_line_dify/google_drive/drive_state.json

# 一時ファイルディレクトリ
TEMP_DIR=/tmp/drive_watcher

# =====================================================
# Dify アップロード設定
# =====================================================
# インデックス方式 (high_quality / economy)
DIFY_INDEXING_TECHNIQUE=high_quality

# 処理ルールモード (automatic / custom)
DIFY_PROCESS_RULE_MODE=automatic

# =====================================================
# 通知設定 (オプション)
# =====================================================
# エラー通知用Slack Webhook URL
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# エラー通知用メールアドレス
# ADMIN_EMAIL=admin@your-company.com

# =====================================================
# Hostinger VPS 設定
# =====================================================
# VPSホスト名
VPS_HOSTNAME=your-vps-hostname.hostinger.com

# VPS SSHポート
VPS_SSH_PORT=22

# VPS SSHユーザー
VPS_SSH_USER=root

# アプリケーションディレクトリ
APP_DIR=/opt/real_estate_line_dify

# =====================================================
# バックアップ設定 (オプション)
# =====================================================
# バックアップディレクトリ
# BACKUP_DIR=/opt/real_estate_line_dify/backups

# バックアップ保持日数
# BACKUP_RETENTION_DAYS=30

# =====================================================
# モニタリング設定 (オプション)
# =====================================================
# Sentry DSN (エラートラッキング)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Analytics トラッキングID
# GA_TRACKING_ID=UA-XXXXXXXXX-X

# =====================================================
# レート制限設定
# =====================================================
# 1ユーザーあたりの1分間のリクエスト上限
RATE_LIMIT_PER_MINUTE=20

# 1ユーザーあたりの1時間のリクエスト上限
RATE_LIMIT_PER_HOUR=100

# =====================================================
# キャッシュ設定 (オプション)
# =====================================================
# Redis URL (キャッシュ・セッション管理用)
# REDIS_URL=redis://localhost:6379/0

# キャッシュ有効期限 (秒)
# CACHE_TTL=3600

# =====================================================
# その他設定
# =====================================================
# タイムゾーン
TIMEZONE=Asia/Tokyo

# デバッグモード (true / false)
DEBUG=false

# セッションタイムアウト (秒)
SESSION_TIMEOUT=1800

# =====================================================
# 設定完了後の確認事項
# =====================================================
# 1. .env ファイルの権限を制限: chmod 600 .env
# 2. .gitignore に .env が含まれていることを確認
# 3. 各サービスの認証情報が正しく設定されているか確認
# 4. systemctl や supervisor で環境変数が読み込まれるか確認
